/* 全局样式 */
page {
  background-color: #F5F5F7;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  color: #1D1D1F;
}

/* 通用类 */
.container {
  padding: 20rpx 30rpx;
  padding-top: 20rpx;
  padding-bottom: 200rpx;
}

/* 苹果风格卡片 */
.apple-card {
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 8px 30px rgba(0,0,0,0.04);
  border: 1rpx solid #ffffff;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

/* 小米橙色按钮 */
.xiaomi-btn {
  background: #FF6700;
  color: #ffffff;
  border-radius: 999rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(255,103,0,0.2);
  border: none;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  text-align: center;
  /* 按下快、松手弹性回弹（动效2） */
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.35s ease-out;
}

.xiaomi-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
  transition-duration: 0.08s;
}

/* 玻璃态效果 */
.glass-morphism {
  background: rgba(255,255,255,0.8);
  backdrop-filter: blur(40rpx);
  border-top: 1rpx solid rgba(255,255,255,0.2);
}

/* 隐藏滚动条 */
::-webkit-scrollbar {
  display: none;
}

/* 文字颜色 */
.text-primary {
  color: #1D1D1F;
}

.text-secondary {
  color: #86868b;
}

.text-orange {
  color: #FF6700;
}

/* 选项切换按钮 */
.option-toggle {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 20rpx;
  font-weight: bold;
  background: #F5F5F7;
  color: #86868b;
  border: 1rpx solid #f0f0f0;
  transition: background-color 0.25s, color 0.25s, box-shadow 0.25s;
}

.option-toggle.active {
  background: #FF6700;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(255,103,0,0.3);
  /* 选中时整颗药丸弹性放大（动效4） */
  animation: popIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  text-align: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255,103,0,0.08);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

/* 价格样式 */
.price {
  font-size: 36rpx;
  font-weight: 900;
  color: #FF6700;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

/* 标签 */
.badge {
  font-size: 18rpx;
  font-weight: 900;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.badge-amber {
  background: rgba(245,158,11,0.1);
  color: #d97706;
}

.badge-green {
  background: rgba(34,197,94,0.1);
  color: #16a34a;
}

.badge-blue {
  background: rgba(59,130,246,0.1);
  color: #2563eb;
}

.badge-orange {
  background: rgba(255,103,0,0.1);
  color: #FF6700;
}

.badge-gray {
  background: rgba(107,114,128,0.1);
  color: #6b7280;
}

/* ==================== 微动效（全局复用） ==================== */

/* 动效1：卡片入场——从下方 24rpx 浮入；配合内联 animation-delay 做错落感 */
@keyframes rise {
  from { opacity: 0; transform: translateY(24rpx); }
}

.card-enter {
  animation: rise 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

/* 动效4/6 复用：弹性 pop（选中放大回弹） */
@keyframes popIn {
  0% { transform: scale(0.85); }
  55% { transform: scale(1.06); }
  100% { transform: scale(1); }
}

/* 动效8：二维码扫光——高光斜条从左到右扫过，父容器需 position:relative + overflow:hidden */
.qr-shine {
  position: absolute;
  top: -30%;
  left: 0;
  width: 100%;
  height: 160%;
  background: linear-gradient(105deg, rgba(255,255,255,0) 40%, rgba(255,255,255,0.75) 50%, rgba(255,255,255,0) 60%);
  transform: translateX(-120%);
  animation: qrShine 2.8s ease-in-out 0.6s infinite;
  pointer-events: none;
}

@keyframes qrShine {
  0% { transform: translateX(-120%); }
  55%, 100% { transform: translateX(120%); }
}
