/* pages/admin/admin.wxss */

/* 无权限 */
.no-access {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  gap: 24rpx;
}

.no-access-icon {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.4;
}

.no-access-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #86868b;
}

/* 加载 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 160rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #FF6700;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 管理面板头部 */
.admin-header {
  margin-bottom: 48rpx;
}

.admin-title {
  font-size: 40rpx;
  font-weight: 900;
}

.admin-subtitle {
  font-size: 20rpx;
  text-transform: uppercase;
  font-weight: 900;
  color: #86868b;
  letter-spacing: 4rpx;
  margin-top: 8rpx;
}

/* 订单列表 */
.orders-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 80rpx;
}

.admin-order-card {
  padding: 30rpx;
}

/* 订单顶部 */
.order-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.order-top-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-badge {
  font-size: 20rpx;
  font-weight: 900;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.order-id-text {
  font-weight: 900;
  font-size: 26rpx;
}

.order-amount {
  font-size: 22rpx;
  font-weight: bold;
  color: #FF6700;
  font-style: italic;
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #86868b;
  margin-bottom: 20rpx;
}

.user-icon {
  width: 24rpx;
  height: 24rpx;
}

/* 下单人头像（云存储 fileID 直接作为 image src） */
.user-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f3f4f6;
  flex-shrink: 0;
}

.user-email {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 260rpx;
  font-size: 18rpx;
}

.user-dot {
  margin: 0 4rpx;
}

/* 取件信息 */
.pickup-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255,103,0,0.06);
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.pickup-info-icon {
  width: 28rpx;
  height: 28rpx;
}

.pickup-info-text {
  font-size: 22rpx;
  font-weight: bold;
  color: #FF6700;
}

/* 备注 */
.remark-display {
  background: rgba(245,158,11,0.06);
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.remark-display-label {
  font-size: 22rpx;
  font-weight: bold;
  color: #b45309;
  flex-shrink: 0;
}

.remark-display-text {
  font-size: 22rpx;
  color: #b45309;
  line-height: 1.4;
}

/* 文件区域 */
.admin-files {
  background: rgba(245,247,250,0.5);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.admin-file-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
  flex-wrap: wrap;
}

.admin-file-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.admin-file-name {
  font-size: 24rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.admin-file-range {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: bold;
  color: #FF6700;
  background: rgba(255,103,0,0.08);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.admin-file-copies {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: bold;
  color: #5F5E5A;
  background: rgba(95,94,90,0.08);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.view-file-btn {
  font-size: 18rpx;
  font-weight: 900;
  color: #3b82f6;
  background: rgba(59,130,246,0.08);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.view-file-btn:active {
  opacity: 0.7;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: bold;
  padding: 20rpx 0;
  text-align: center;
  border: none;
  line-height: 1;
}

.action-btn::after {
  border: none;
}

.confirm-pay-btn {
  flex: 1;
  background: #9333ea;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(147,51,234,0.2);
}

.advance-btn {
  flex: 1;
  background: #1D1D1F;
  color: #ffffff;
}

.cancel-btn {
  background: #F5F5F7;
  color: #ef4444;
  font-size: 24rpx;
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1.2;
}

.load-more {
  text-align: center;
  padding: 30rpx 0;
  color: #86868b;
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 30rpx 0;
  color: #c7c7cc;
  font-size: 24rpx;
}

/* 核款计价输入 */
.recalc-inline {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-basis: 100%;
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.recalc-label {
  font-size: 20rpx;
  color: #86868b;
  flex-shrink: 0;
}

.recalc-input {
  width: 120rpx;
  min-height: 48rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 0 12rpx;
  font-size: 22rpx;
}

.recalc-btn {
  background: #22c55e;
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1.2;
}

.recalc-btn:active {
  opacity: 0.85;
}
