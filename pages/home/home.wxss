/* pages/home/home.wxss */

/* Header */
.header {
  margin-bottom: 40rpx;
  padding-top: 20rpx;
}

.header-title {
  font-size: 56rpx;
  font-weight: 900;
  color: #1D1D1F;
  line-height: 1.2;
  letter-spacing: -2rpx;
}

.header-subtitle {
  font-size: 26rpx;
  font-weight: bold;
  color: #86868b;
  letter-spacing: 2rpx;
  background: rgba(255,255,255,0.5);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
  margin-top: 8rpx;
}

/* 空状态卡片 */
.empty-card {
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 8px 30px rgba(0,0,0,0.04);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon-wrapper {
  width: 200rpx;
  height: 200rpx;
  background: rgba(255,103,0,0.06);
  border-radius: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: inset 0 4rpx 12rpx rgba(0,0,0,0.03);
  /* 动效9：上传图标轻轻漂浮，引导点击 */
  animation: floatY 2.6s ease-in-out infinite;
}

@keyframes floatY {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14rpx); }
}

.empty-icon-img {
  width: 80rpx;
  height: 80rpx;
}

.empty-text {
  margin-bottom: 40rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #86868b;
  padding: 0 40rpx;
  line-height: 1.6;
}

.upload-btn {
  margin-top: 20rpx;
  min-width: 300rpx;
}

/* 文件列表 */
.file-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.file-item {
  padding: 30rpx;
}

.file-row {
  display: flex;
  gap: 24rpx;
}

.file-icon-wrapper {
  width: 96rpx;
  height: 112rpx;
  background: #F5F5F7;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  border: 1rpx solid #f0f0f0;
}

.file-icon-img {
  width: 48rpx;
  height: 48rpx;
}

/* 图片缩略图（替代文件图标）
 * 注意：<image> 在微信里是原生组件，作为 flex item 在 align-items:center 的父容器里
 * 常因交叉轴不 stretch 而塌缩（表现为"不显示"）。这里用绝对定位脱离 flex 流、
 * 铺满 wrapper（wrapper 已 position:relative），与图标分支、角标、警告点互不干扰。 */
.file-thumb {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

/* 文件类型角标（右下角，与右上角警告点共存） */
.file-type-badge {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  font-size: 18rpx;
  font-weight: 900;
  color: #ffffff;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #FF6700;
  line-height: 1.2;
}

.file-type-badge.badge-pdf {
  background: #FF6700;
}

.file-type-badge.badge-doc {
  background: #3B82F6;
}

.file-type-badge.badge-ppt {
  background: #F59E0B;
}

.file-type-badge.badge-xls {
  background: #22C55E;
}

.file-warning-dot {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #ffffff;
  border-radius: 50%;
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.warning-icon {
  width: 28rpx;
  height: 28rpx;
}

.file-details {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.file-name {
  font-size: 26rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 16rpx;
}

/* 页数控制 */
.pages-control {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  background: #F5F5F7;
  padding: 8rpx 12rpx;
  border-radius: 16rpx;
  display: inline-flex;
}

.pages-control.pages-warning {
  background: rgba(245,158,11,0.1);
  box-shadow: 0 0 0 4rpx rgba(245,158,11,0.4);
}

.page-btn {
  width: 48rpx;
  height: 48rpx;
  background: #ffffff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  /* 动效2：快按慢弹 */
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.page-btn:active {
  transform: scale(0.9);
  transition-duration: 0.06s;
}

.page-count {
  font-size: 26rpx;
  font-weight: 900;
  min-width: 60rpx;
  text-align: center;
}

.page-count-warning {
  color: #b45309;
}

.page-input {
  font-size: 26rpx;
  font-weight: 900;
  min-width: 60rpx;
  width: 80rpx;
  text-align: center;
  border: none;
  background: transparent;
  padding: 0;
  height: 48rpx;
  line-height: 48rpx;
}

.pages-label {
  font-size: 20rpx;
  font-weight: 900;
  color: #86868b;
  text-transform: uppercase;
}

.estimate-badge {
  font-size: 20rpx;
  font-weight: bold;
  color: #d97706;
  background: rgba(245,158,11,0.15);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.badge-warning-icon {
  width: 20rpx;
  height: 20rpx;
}

/* 文件选项 */
.file-options {
  display: flex;
  gap: 12rpx;
  margin-top: 4rpx;
}

.option-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 900;
}

.option-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #d1d5db;
}

.dot-active {
  background: #ffffff;
}

/* 右侧价格和删除 */
.file-right {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  flex-shrink: 0;
}

.remove-btn {
  padding: 8rpx;
}

.close-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

/* 继续添加按钮 */
.add-more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
  border: 3rpx dashed #e5e7eb;
  border-radius: 32rpx;
  color: #86868b;
  font-size: 26rpx;
  font-weight: bold;
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.2s, border-color 0.2s;
}

.add-more-btn:active {
  color: #FF6700;
  border-color: #FF6700;
  transform: scale(0.97);
}

.plus-icon {
  width: 36rpx;
  height: 36rpx;
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.add-more-btn:active .plus-icon {
  transform: rotate(90deg);
}

/* 取件方式 */
.delivery-section {
  margin-top: 48rpx;
}

.pickup-cards {
  display: flex;
  gap: 20rpx;
}

.pickup-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 30rpx 16rpx;
  border: 3rpx solid #ffffff;
  transition: all 0.3s;
  position: relative;
}

.pickup-card.pickup-active {
  border-color: #FF6700;
  background: rgba(255,103,0,0.03);
}

.pickup-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F7;
  margin-bottom: 12rpx;
}

.pickup-icon-wrapper.pickup-icon-active {
  background: #FF6700;
  /* 动效5：选中时图标跳一下 */
  animation: iconBob 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes iconBob {
  0% { transform: translateY(0); }
  45% { transform: translateY(-8rpx) scale(1.1); }
  100% { transform: translateY(0); }
}

.pickup-icon-wrapper.pickup-icon-active .pickup-icon {
  filter: brightness(0) invert(1);
}

.pickup-icon {
  width: 40rpx;
  height: 40rpx;
}

.pickup-label {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.pickup-desc {
  font-size: 20rpx;
  color: #86868b;
}

.pickup-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.pickup-check.check-active {
  background: #FF6700;
  border-color: #FF6700;
  box-shadow: 0 4rpx 16rpx rgba(255,103,0,0.3);
}

.check-dot {
  width: 12rpx;
  height: 12rpx;
  background: #ffffff;
  border-radius: 50%;
  /* 动效5：对勾圆点在选中瞬间弹出（wx:if 创建节点时播放） */
  animation: dotIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes dotIn {
  from { transform: scale(0); }
}

/* 时间选择 */
.time-section {
  margin-top: 24rpx;
  background: rgba(255,103,0,0.03);
  border: 1rpx solid rgba(255,103,0,0.15);
  border-radius: 24rpx;
  padding: 24rpx;
}

.time-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #1D1D1F;
}

.time-header-icon {
  width: 28rpx;
  height: 28rpx;
}

.time-scroll {
  white-space: nowrap;
}

.time-list {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.time-slot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: bold;
  background: #ffffff;
  color: #1D1D1F;
  border: 2rpx solid #e5e7eb;
  flex-shrink: 0;
  transition: all 0.2s;
}

.time-slot.time-selected {
  background: #FF6700;
  color: #ffffff;
  border-color: #FF6700;
  box-shadow: 0 4rpx 16rpx rgba(255,103,0,0.3);
  /* 动效6：时间片选中弹性 */
  animation: popIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.time-slot.time-disabled {
  opacity: 0.35;
  pointer-events: none;
}

.time-tip {
  font-size: 20rpx;
  color: #86868b;
  margin-top: 12rpx;
  text-align: center;
}

/* 取件方式标签 */
.pickup-tag {
  font-size: 18rpx;
  background: rgba(255,103,0,0.1);
  color: #FF6700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: bold;
}

.check-dot {
  width: 16rpx;
  height: 16rpx;
  background: #ffffff;
  border-radius: 50%;
}

.warning-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: rgba(245,158,11,0.06);
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(245,158,11,0.15);
  margin: 0 0 24rpx;
}

.tip-warning-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.warning-tip text {
  font-size: 20rpx;
  font-weight: bold;
  color: #b45309;
  line-height: 1.5;
}

/* 店主休息横幅 */
.closed-tip {
  background: rgba(255,103,0,0.08);
  border: 1rpx solid rgba(255,103,0,0.2);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin: 0 0 24rpx;
}

.closed-tip text {
  font-size: 20rpx;
  font-weight: bold;
  color: #c2410c;
  line-height: 1.5;
}

/* 顾客身份卡（头像昵称） */
.profile-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin: 0 0 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.profile-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f3f4f6;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #1D1D1F;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-desc {
  font-size: 20rpx;
  color: #86868b;
  margin-top: 4rpx;
}

/* 头像昵称设置弹窗 */
.profile-modal {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.avatar-choose-btn {
  background: transparent;
  padding: 0;
  margin: 24rpx auto 8rpx;
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.4;
}

.avatar-choose-btn::after {
  border: none;
}

.avatar-preview {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #f3f4f6;
}

.avatar-choose-tip {
  font-size: 20rpx;
  color: #86868b;
  margin-top: 8rpx;
}

.nickname-input {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: #f5f5f7;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #1D1D1F;
  margin: 16rpx 0;
  box-sizing: border-box;
}

.nickname-placeholder {
  color: #c0c0c8;
  font-size: 24rpx;
}

/* 底部结算栏（在 tab bar 上方） */
.checkout-bar {
  position: fixed;
  bottom: calc(110rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(40rpx);
  border-top: 1rpx solid rgba(255,255,255,0.2);
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
}

.checkout-left {
  flex: 1;
}

.checkout-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 20rpx;
  font-weight: 900;
  color: #86868b;
  text-transform: uppercase;
}

.free-badge {
  font-size: 18rpx;
  background: #22c55e;
  color: #ffffff;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: bold;
}

.checkout-price {
  font-size: 40rpx;
  font-weight: 900;
  color: #1D1D1F;
  margin-top: 4rpx;
}

.checkout-btn {
  height: 88rpx;
  padding: 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

/* 支付弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(29,29,31,0.4);
  backdrop-filter: blur(16rpx);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 30rpx;
  padding-bottom: 60rpx;
  animation: overlayIn 0.3s ease-out;
}

@keyframes overlayIn {
  from { opacity: 0; }
}

.modal-content {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 64rpx;
  padding: 60rpx 48rpx;
  text-align: center;
  box-shadow: 0 40rpx 80rpx rgba(0,0,0,0.15);
  /* 动效7：弹窗底部弹簧上滑（wx:if 创建节点时播放） */
  animation: modalUp 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modalUp {
  from { transform: translateY(90rpx) scale(0.94); opacity: 0; }
}

.modal-icon-success {
  width: 128rpx;
  height: 128rpx;
  background: rgba(34,197,94,0.08);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  position: relative;
  /* 动效7：成功图标 pop 弹出 */
  animation: successPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s backwards;
}

.modal-icon-success::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  border: 3rpx solid #22C55E;
  opacity: 0;
  /* 动效7：光环向外扩散一次 */
  animation: ringOut 0.8s ease-out 0.4s;
}

@keyframes successPop {
  0% { transform: scale(0); }
  60% { transform: scale(1.15); }
  100% { transform: scale(1); }
}

@keyframes ringOut {
  0% { transform: scale(1); opacity: 0.55; }
  100% { transform: scale(1.9); opacity: 0; }
}

.success-icon {
  width: 64rpx;
  height: 64rpx;
}

.modal-title {
  font-size: 40rpx;
  font-weight: 900;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: #86868b;
  line-height: 1.6;
}

.qr-section {
  background: #F5F5F7;
  border-radius: 40rpx;
  padding: 40rpx;
  margin: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  border: 1rpx solid #f0f0f0;
}

.qr-placeholder {
  width: 300rpx;
  height: 300rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx dashed #e5e7eb;
  position: relative;
  overflow: hidden;
}

.qr-image {
  width: 260rpx;
  height: 260rpx;
}

.qr-tip {
  font-size: 20rpx;
  font-weight: 900;
  color: #86868b;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.modal-btn {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  margin-bottom: 24rpx;
}

.modal-cancel {
  font-size: 24rpx;
  font-weight: bold;
  color: #86868b;
  padding: 12rpx;
}

/* 备注 */
.remark-section {
  margin-top: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8px 30px rgba(0,0,0,0.04);
}

.remark-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.remark-icon {
  width: 28rpx;
  height: 28rpx;
}

.remark-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1D1D1F;
}

.remark-optional {
  font-size: 20rpx;
  color: #86868b;
  margin-left: 8rpx;
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  color: #1D1D1F;
  padding: 16rpx;
  background: #F5F5F7;
  border-radius: 16rpx;
  box-sizing: border-box;
  line-height: 1.5;
}

.remark-placeholder {
  color: #c0c0c0;
  font-size: 24rpx;
}

.remark-count {
  text-align: right;
  font-size: 20rpx;
  color: #c0c0c0;
  margin-top: 8rpx;
}

/* 底部留白：结算栏 + tab bar 的高度 */
.bottom-spacer {
  height: 300rpx;
}

/* 计价说明 */
.price-tips {
  margin-top: 32rpx;
  text-align: center;
  padding-bottom: 20rpx;
}

.tips-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.5);
  padding: 24rpx 48rpx;
  border-radius: 40rpx;
  border: 1rpx solid #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.tips-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  font-weight: bold;
  color: #86868b;
}

.info-icon {
  width: 28rpx;
  height: 28rpx;
}

.tips-content {
  display: flex;
  gap: 32rpx;
}

.tips-content text {
  font-size: 18rpx;
  color: #86868b;
}

/* 配送信息 */
.address-section {
  margin-top: 24rpx;
  background: rgba(255,103,0,0.03);
  border: 1rpx solid rgba(255,103,0,0.15);
  border-radius: 24rpx;
  padding: 24rpx;
}

.address-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #1D1D1F;
}

.address-icon {
  width: 28rpx;
  height: 28rpx;
}

.address-required {
  font-size: 18rpx;
  color: #FF6700;
  background: rgba(255,103,0,0.1);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.address-input {
  width: 100%;
  height: 90rpx;
  line-height: 88rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #1D1D1F;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid #f0f0f0;
}

.address-input:last-child {
  margin-bottom: 0;
}

/* 按实际页数核价提示 */
.modal-adjusted {
  display: inline-block;
  font-size: 22rpx;
  font-weight: bold;
  color: #d97706;
  background: rgba(245,158,11,0.1);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin: 16rpx 0;
}

/* 打印范围 */
.range-control {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
  margin-bottom: 8rpx;
}

.range-label {
  font-size: 22rpx;
  color: #86868b;
}

.range-input {
  flex: 1;
  min-width: 240rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #1D1D1F;
  box-sizing: border-box;
}

.range-hint {
  font-size: 22rpx;
  color: #22C55E;
}

.range-error {
  font-size: 22rpx;
  color: #F59E0B;
}

/* 动效3：金额跳动——a/b 两组交替使用，保证每次都能重新触发动画 */
.price-anim-a {
  animation: bumpA 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.price-anim-b {
  animation: bumpB 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes bumpA {
  0% { transform: scale(1); }
  35% { transform: scale(1.25); }
  100% { transform: scale(1); }
}

@keyframes bumpB {
  0% { transform: scale(1); }
  35% { transform: scale(1.25); }
  100% { transform: scale(1); }
}
